{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/XKHoshizora/specmetry/schemas/source-ack.v1.schema.json",
  "title": "Specmetry source change acknowledgement v1",
  "description": "Human-only. Confirms that a change to a registered source has been handled (baseline updated or no change needed). observed_sha256 must equal the file's current on-disk hash.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "observed_sha256", "rationale"],
  "properties": {
    "schema": { "const": "specmetry.source-ack/v1" },
    "source": {
      "description": "Registered path or source ULID.",
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "observed_sha256": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "rationale": { "$ref": "common.v1.schema.json#/$defs/rationale" }
  }
}
