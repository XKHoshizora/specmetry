{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/XKHoshizora/specmetry/schemas/target-scope.v1.schema.json",
  "title": "Specmetry delivery target and scope v1",
  "description": "Output of both `specmetry target show --json` and `specmetry scope show --json`: the active delivery target, its current scope confirmation, and the current values a new scope confirmation (scope.v1) must carry, including the effective waivers it must acknowledge (PD-21, V-T01). Staleness here only compares versions and hashes; delivery status is derived by status.v1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "target", "scope", "confirm_inputs"],
  "properties": {
    "schema": { "const": "specmetry.target-scope/v1" },
    "target": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "ref", "snapshot", "created_seq"],
          "properties": {
            "id": { "$ref": "common.v1.schema.json#/$defs/ulid" },
            "name": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\r\\n]*$" },
            "ref": { "type": "string", "pattern": "^refs/(heads|tags)/.+$" },
            "snapshot": {
              "description": "The commit the ref resolves to now; null when it cannot be resolved.",
              "oneOf": [{ "$ref": "common.v1.schema.json#/$defs/commitSha" }, { "type": "null" }]
            },
            "created_seq": { "$ref": "common.v1.schema.json#/$defs/seq" }
          }
        }
      ]
    },
    "scope": {
      "description": "The target's latest scope confirmation, or null.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "confirmation_id",
            "seq",
            "baseline_version",
            "source_set_hash",
            "requirements",
            "attestations",
            "acknowledged_waivers",
            "stale"
          ],
          "properties": {
            "confirmation_id": { "$ref": "common.v1.schema.json#/$defs/ulid" },
            "seq": { "$ref": "common.v1.schema.json#/$defs/seq" },
            "baseline_version": { "type": "integer", "minimum": 1 },
            "source_set_hash": { "$ref": "common.v1.schema.json#/$defs/sha256" },
            "requirements": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key", "revision"],
                "properties": {
                  "key": { "$ref": "common.v1.schema.json#/$defs/requirementKey" },
                  "revision": {
                    "description": "Revision at confirmation time.",
                    "$ref": "common.v1.schema.json#/$defs/revision"
                  }
                }
              }
            },
            "attestations": { "$ref": "scope.v1.schema.json#/$defs/attestations" },
            "acknowledged_waivers": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "common.v1.schema.json#/$defs/ulid" }
            },
            "stale": {
              "description": "true when the baseline version or the source-set hash changed since confirmation (SCOPE_STALE).",
              "type": "boolean"
            }
          }
        }
      ]
    },
    "confirm_inputs": {
      "description": "Current values for a new confirmation of this target. A confirmation built from them is still rejected if anything changes before it is written.",
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "baseline_version", "source_set_hash", "pending_items", "must_requirements", "effective_waivers"],
      "properties": {
        "target_id": { "oneOf": [{ "$ref": "common.v1.schema.json#/$defs/ulid" }, { "type": "null" }] },
        "baseline_version": { "$ref": "common.v1.schema.json#/$defs/baselineVersion" },
        "source_set_hash": { "$ref": "common.v1.schema.json#/$defs/sha256" },
        "pending_items": {
          "description": "Pending and conflict proposal items: the value of attestations.pending_items_excluded for a standalone confirmation.",
          "type": "integer",
          "minimum": 0
        },
        "must_requirements": {
          "description": "Active requirements with priority must: the interactive default selection (FR-TGT-07), not a rule.",
          "type": "array",
          "items": { "$ref": "common.v1.schema.json#/$defs/requirementKey" }
        },
        "effective_waivers": {
          "description": "Every waiver currently in effect on an active criterion, with its requirement so a client can keep those of the requirements it confirms. The reviewer must be shown each one with its rationale and send back the IDs of those under the confirmed requirements as acknowledged_waivers.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decision_id", "criterion", "criterion_revision", "requirement", "rationale", "seq"],
            "properties": {
              "decision_id": { "$ref": "common.v1.schema.json#/$defs/ulid" },
              "criterion": { "$ref": "common.v1.schema.json#/$defs/criterionKey" },
              "criterion_revision": { "$ref": "common.v1.schema.json#/$defs/revision" },
              "requirement": { "$ref": "common.v1.schema.json#/$defs/requirementKey" },
              "rationale": { "$ref": "common.v1.schema.json#/$defs/rationale" },
              "seq": { "$ref": "common.v1.schema.json#/$defs/seq" }
            }
          }
        }
      }
    }
  }
}
